{
  "version": "1.0",
  "name": "code402",
  "description": "Deterministic, machine-verifiable paid tools for AI agents. Per-call x402 (HTTP 402) payments in USDC on Base; every call returns a signed, offline-verifiable receipt.",
  "url": "https://code402.dev",
  "payment": {
    "protocol": "x402",
    "network": "base",
    "asset": "USDC",
    "flow": "402 challenge -> EIP-3009 signed authorization -> 200 + XDR-1 receipt"
  },
  "tools": [
    {"name": "vat-mod97-check", "price_usdc": "0.005", "input": "vat_number", "description": "ISO 7064 MOD-97 VAT number validation"},
    {"name": "company-number-format", "price_usdc": "0.005", "input": "company_number", "description": "UK Companies House number format validation"},
    {"name": "context-distill", "price_usdc": "0.005", "input": "html", "description": "Deterministic HTML-to-text extraction"},
    {"name": "iban-check", "price_usdc": "0.005", "input": "iban", "description": "IBAN checksum validation"},
    {"name": "lei-check", "price_usdc": "0.005", "input": "lei", "description": "LEI checksum validation"},
    {"name": "isin-check", "price_usdc": "0.005", "input": "isin", "description": "ISIN checksum validation"},
    {"name": "luhn-check", "price_usdc": "0.005", "input": "number", "description": "Luhn algorithm validation"},
    {"name": "swift-bic-check", "price_usdc": "0.005", "input": "bic", "description": "SWIFT BIC format validation"},
    {"name": "ean13-check", "price_usdc": "0.005", "input": "ean", "description": "EAN-13 checksum validation"},
    {"name": "gstin-check", "price_usdc": "0.005", "input": "gstin", "description": "GSTIN validation and canonicalisation"}
  ],
  "docs": "https://code402.dev/llms.txt"
}
